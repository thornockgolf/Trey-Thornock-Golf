{
  "name": "trey-thornock-golf",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @ttg/marketing dev",
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "dev:app": "bun run --filter @ttg/app dev",
    "db:migrate": "bun run --filter @ttg/db migrate",
    "db:seed-plan": "bun --env-file=.env packages/db/src/seed-plan.ts"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
