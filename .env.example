# Names only. Copy to .env (gitignored) and fill in. Never commit real values.

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- App server (production only; adapter-node) ---
# ORIGIN=https://app.treythornockgolf.com

# --- Clerk (apps/app) ---
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
COACH_CLERK_USER_IDS=

# --- Cloudflare R2 (S3 API; one private bucket, keys use raw/ processed/ analysis/ profile/ prefixes) ---
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
