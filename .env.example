# Names only. Copy to .env (gitignored) and fill in. Never commit real values.

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- App server (production only; adapter-node) ---
# ORIGIN=https://app.treythornockgolf.com

# --- Clerk (apps/app) ---
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
COACH_CLERK_USER_IDS=

# --- Cloudflare R2 (S3 API; one private bucket, keys use raw/ processed/ analysis/ profile/ prefixes) ---
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Stripe (apps/app; test keys until launch). Prices live in Stripe; the app reads their ids ---
STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ASSESSMENT
STRIPE_PRICE_MEMBERSHIP
PUBLIC_STRIPE_PUBLISHABLE_KEY

# --- Supabase Realtime (optional: without these the chat and badges poll). apps/app and apps/worker ---
PUBLIC_SUPABASE_URL
PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET

# --- Web push (optional: without these no browser notifications are sent). apps/app and apps/worker ---
# Make the pair with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY
VAPID_SUBJECT
